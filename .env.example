# ===== 大模型配置（BYOK）=====
# 三项可配即可接任意 OpenAI 兼容接口。Key 只留在服务端，绝不进前端 bundle。
# 不填 Key 时自动走 mock 模式，CI 与离线开发不依赖外网。

# 可选值：openai | deepseek | dashscope | moonshot | zhipu | ollama | mock
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 生成预算（token），超限截断并告警
LLM_MAX_TOKENS=60000
LLM_TIMEOUT_MS=120000

# ===== 存储 =====
# SQLite 文件路径（相对项目根）
DATABASE_PATH=./data/app.db
